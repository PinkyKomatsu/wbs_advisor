    "name": ["作業項目", "管理単位（小）"],
    "unit_l": ["管理単位（大）"],
    "unit_m1": ["管理単位（中１）", "管理単位（中1）"]
  },
  "thresholds": {
    "required": 0.7,
    "unneeded": 0.3
