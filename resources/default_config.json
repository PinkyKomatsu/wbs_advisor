{
  "wbs_types": ["設計", "構築", "テスト"],
  "header_keywords": {
    "_説明": "列見出し → 列の意味。ひな形の「大分類・中分類・作業項目」と、実用WBSの「管理単位（中２）・（中３）・（小）」を同じ意味にすることで、読み取り・照合・転記がそろう",
    "cat1": ["大分類", "管理単位（中２）", "管理単位（中2）"],
