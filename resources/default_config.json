  "value_map": {
    "*": {},
    "owner": {"病院": "病院情報システム部"},
    "status": {}
  },
  "profile": {
    "header_scan_rows": 30,
    "confidence_threshold": 0.7,
    "blank_rows_to_stop": 5
  },
  "output": {
    "include_parents": true,
    "repeat_categories": true,
    "clear_sample_rows": true,
    "engine": "auto"
  },
  "copy": {
